# One-time setup for the Prod account: creates the S3 bucket that holds Terraform
# state for infra/envs/prod/*, and writes infra/envs/prod/backend.hcl pointing at it.
#
# This folder keeps its own state locally (terraform.tfstate here, not committed),
# because the bucket it creates doesn't exist yet. See infra/README.md.

terraform {
  required_version = ">= 1.10"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
    local = {
      source  = "hashicorp/local"
      version = "~> 2.5"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}

locals {
  environment = "prod"
  aws_profile = "meantime-prod"
  aws_region  = "us-east-2"
}

provider "aws" {
  profile = local.aws_profile
  region  = local.aws_region

  default_tags {
    tags = {
      Project     = "MeanTime"
      Environment = local.environment
      ManagedBy   = "Terraform"
    }
  }
}

module "state_bucket" {
  source = "../../modules/state-bucket"

  environment = local.environment
}

# Shared backend settings for every folder under infra/envs/prod/.
# Commit the generated file; it holds no secrets.
resource "local_file" "backend_config" {
  filename        = "${path.module}/../../envs/${local.environment}/backend.hcl"
  file_permission = "0644"
  content         = <<-EOT
    # Generated by infra/bootstrap/${local.environment}. Do not edit by hand.
    bucket       = "${module.state_bucket.bucket_name}"
    region       = "${local.aws_region}"
    profile      = "${local.aws_profile}"
    encrypt      = true
    use_lockfile = true
  EOT
}

output "state_bucket" {
  description = "S3 bucket holding Terraform state for Prod."
  value       = module.state_bucket.bucket_name
}
