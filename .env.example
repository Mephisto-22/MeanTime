# ==========================================
# MeanTime Environment Configuration
# ==========================================

# PostgreSQL Database Configuration
POSTGRES_DB=meantime
POSTGRES_USER=meantime_user
POSTGRES_PASSWORD=meantime_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_PORT=5432

# Django Backend Configuration
DJANGO_SECRET_KEY=django-insecure-dev-secret-key-change-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
BACKEND_PORT=8000

# Frontend Nuxt Configuration
FRONTEND_PORT=3000
BACKEND_INTERNAL_URL=http://backend:8000
PRIMEVUE_LICENSE_KEY=

# File Watcher (Force polling inside Docker on Windows hosts)
WATCHFILES_FORCE_POLLING=true
